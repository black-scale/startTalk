{
    "compilerOptions": {
      "target": "es2022",
      "module": "es2022",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "moduleResolution": "bundler",
      "outDir": "../lib",
      "resolveJsonModule": true,
      "paths": {
        "$amplify/*": [
          "../../../../.amplify/generated/*"
        ]
      },
        "include": [
        "src",
        "web-push.d.ts" // 혹은 상대경로로 "amplify/functions/pushSender/src/web-push.d.ts"
      ]
    },
    
  }
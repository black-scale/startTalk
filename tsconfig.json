{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  "exclude": ["amplify/**/*"],
  "compilerOptions": {
    
    "target": "ES2022",
    "noEmit": true, 
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true ,
    "allowJs": true,
  },
}
